<Window x:Class="WpfSample.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WPF E2E Sample" Width="440" Height="360" WindowStartupLocation="Manual" Left="20" Top="20" FontFamily="Segoe UI" FontSize="12">
  <DockPanel>
    <Menu DockPanel.Dock="Top"><MenuItem Header="ファイル(_F)"><MenuItem x:Name="mnuExit" Header="終了(_X)" Click="mnuExit_Click"/></MenuItem></Menu>
    <StackPanel Margin="16">
      <StackPanel Orientation="Horizontal">
        <TextBox x:Name="txtName" Width="200" AutomationProperties.AutomationId="txtName"/>
        <Button ToolTip="挨拶を実行" x:Name="btnGreet" Content="挨拶" Width="80" Margin="10,0,0,0" Click="btnGreet_Click" AutomationProperties.AutomationId="btnGreet"/>
      </StackPanel>
      <TextBlock x:Name="lblResult" Text="(未実行)" Margin="0,12,0,0"><TextBlock.ContextMenu><ContextMenu><MenuItem x:Name="mnuReset" Header="リセット(_R)" Click="mnuReset_Click"/></ContextMenu></TextBlock.ContextMenu></TextBlock>
      <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
        <ComboBox x:Name="cmbMode" Width="200" SelectedIndex="0"><ComboBoxItem>通常</ComboBoxItem><ComboBoxItem>丁寧</ComboBoxItem><ComboBoxItem>カジュアル</ComboBoxItem></ComboBox>
        <CheckBox x:Name="chkUpper" Content="大文字化" Margin="10,3,0,0"/>
      </StackPanel>
      <DataGrid x:Name="grid" Margin="0,16,0,0" Height="120" AutoGenerateColumns="False" CanUserAddRows="False">
        <DataGrid.Columns><DataGridTextColumn Header="項目" Binding="{Binding Key}"/><DataGridTextColumn Header="値" Binding="{Binding Value}"/></DataGrid.Columns>
      </DataGrid>
    </StackPanel>
  </DockPanel>
</Window>
