<Window x:Class="WpfSample.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WPF Scroll Sample" Width="500" Height="320" WindowStartupLocation="Manual" Left="20" Top="20" FontFamily="Segoe UI" FontSize="12">
  <Grid Margin="10">
    <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="140"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <ListBox x:Name="lstLong" Grid.Row="0" Grid.Column="0"/>
    <DataGrid x:Name="grid" Grid.Row="0" Grid.Column="1" Margin="10,0,0,0" AutoGenerateColumns="False" CanUserAddRows="False">
      <DataGrid.Columns><DataGridTextColumn Header="項目" Binding="{Binding Key}"/><DataGridTextColumn Header="値" Binding="{Binding Value}"/></DataGrid.Columns>
    </DataGrid>
    <ScrollViewer x:Name="sv" Grid.Row="1" Grid.Column="0" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto" Height="100">
      <StackPanel><Border Height="600"/><Button x:Name="btnDeep" Content="deep" Width="100" Click="btnDeep_Click"/></StackPanel>
    </ScrollViewer>
    <TextBlock x:Name="lblStatus" Grid.Row="1" Grid.Column="1" Margin="10,10,0,0" Text="-"/>
  </Grid>
</Window>
